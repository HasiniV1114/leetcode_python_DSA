class Solution:
    def evaluate(self, s: str, knowledge: list[list[str]]) -> str:
        know = {}
        for key, value in knowledge:
            know[key] = value
        result = []
        i = 0
        while i < len(s):
            if s[i] == '(':
                i += 1
                key = ""
                while s[i] != ')':
                    key += s[i]
                    i += 1
                if key in know:
                    result.append(know[key])
                else:
                    result.append("?")
                i += 1   # skip ')'
            else:
                result.append(s[i])
                i += 1
        return "".join(result)
